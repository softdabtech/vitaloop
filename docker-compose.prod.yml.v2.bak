version: '3.9'

# Production Docker Compose Configuration
# Deploy with: docker compose -f docker-compose.prod.yml up -d
# This replaces systemd services for both backend and frontend

services:
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: vitaloop-backend
    restart: unless-stopped
    ports:
      # External port 8004 → Internal port 8000
      - "8004:8000"
    expose:
      - "8000"
    env_file:
      - ./backend/.env
    volumes:
      - backend-data:/app/data
      - ./backend/logs:/app/logs
    environment:
      - LOG_LEVEL=info
      - ENVIRONMENT=production
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    networks:
      - vitaloop-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    command: uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile.prod
    container_name: vitaloop-frontend
    restart: unless-stopped
    ports:
      # External port 8080 → Internal port 80
      - "8080:80"
    expose:
      - "80"
    environment:
      - REACT_APP_API_URL=https://api.vitaloop.today
      - NODE_ENV=production
    volumes:
      - ./frontend/dist:/usr/share/nginx/html:ro
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
    networks:
      - vitaloop-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    depends_on:
      backend:
        condition: service_healthy

  # Optional: nginx reverse proxy (if you want unified frontend/backend routing)
  # nginx:
  #   image: nginx:alpine
  #   container_name: vitaloop-nginx
  #   restart: unless-stopped
  #   ports:
  #     - "443:443"
  #     - "80:80"
  #   volumes:
  #     - ./nginx.vitaloop.conf:/etc/nginx/conf.d/default.conf:ro
  #     - ./certs:/etc/nginx/certs:ro
  #   networks:
  #     - vitaloop-network
  #   depends_on:
  #     - backend
  #     - frontend

volumes:
  backend-data:
    driver: local

networks:
  vitaloop-network:
    driver: bridge
