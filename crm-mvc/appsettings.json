{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "Auth": {
    "FrontendLoginUrl": "https://vitaloop.today/login",
    "TokenCookieName": "vo_access_token",
    "ActiveOrganizationCookieName": "vo_active_org_id",
    "Issuer": "",
    "Audience": "authenticated",
    "JwtPublicKey": ""
  },
  "CrmData": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 30,
    "OrganizationsPath": "/admin/organizations",
    "OrganizationSettingsPath": "/admin/organizations/{orgId}/settings",
    "MembersPath": "/admin/members",
    "InvitationsPath": "/admin/invitations",
    "AssignmentsPath": "/admin/assignments",
    "GlobalUsersPath": "/admin/users",
    "UserContextPath": "/auth/me",
    "UserContextFallbackPath": "/profile"
  }
}
