@model OpsDashboardViewModel

@{
  ViewData["Title"] = "Ops Dashboard";
}

@await Html.PartialAsync("~/Views/Shared/Partials/_Breadcrumbs.cshtml")
@await Html.PartialAsync("~/Views/Shared/Partials/_PageHeader.cshtml", new PageHeaderViewModel { Title = "Ops Dashboard", Subtitle = "Global user visibility — super_admin only", Eyebrow = "Ops" })

<nav class="vo-quick-actions" aria-label="Quick actions">
  <a class="vo-quick-action" href="/ops">
    <span class="vo-quick-action-icon">👤</span> Global Users
  </a>
  <a class="vo-quick-action" href="/ops/activity">
    <span class="vo-quick-action-icon">🧾</span> Activity Log
  </a>
  <a class="vo-quick-action" href="/admin/organizations">
    <span class="vo-quick-action-icon">🏢</span> All Organizations
  </a>
</nav>

<section class="vo-grid two-up" style="margin-bottom: var(--vo-space-6);">
  @await Html.PartialAsync("~/Views/Shared/Ui/_StatCard.cshtml", new StatCardViewModel { Label = "Total Users", Value = Model.TotalUsers.ToString(), Trend = "All organizations", Tone = "teal" })
  @await Html.PartialAsync("~/Views/Shared/Ui/_StatCard.cshtml", new StatCardViewModel { Label = "Organizations", Value = Model.TotalOrganizations.ToString(), Trend = "Multi-org scope", Tone = "default" })
  @await Html.PartialAsync("~/Views/Shared/Ui/_StatCard.cshtml", new StatCardViewModel { Label = "Active Programs", Value = Model.ActivePrograms.ToString(), Trend = "Active assignments", Tone = "default" })
  @await Html.PartialAsync("~/Views/Shared/Ui/_StatCard.cshtml", new StatCardViewModel { Label = "New Registrations (24h)", Value = Model.NewRegistrations24h.ToString(), Trend = "Last 24 hours", Tone = "default" })
</section>

<section class="vo-panel" style="margin-bottom: var(--vo-space-6);">
  <h3 style="margin:0 0 8px 0;">Rate Limiter Runtime</h3>
  @if (!Model.RuntimeReadiness.Available)
  {
    <p style="margin:0; opacity:.8;">Runtime readiness feed is unavailable.</p>
  }
  else
  {
    var redisReachable = Model.RuntimeReadiness.RedisReachable.HasValue
      ? (Model.RuntimeReadiness.RedisReachable.Value ? "yes" : "no")
      : "n/a";
    <div class="vo-grid three-up">
      <div>
        <div style="font-size:.8rem; opacity:.7;">Backend</div>
        <strong>@Model.RuntimeReadiness.LimiterBackend</strong>
      </div>
      <div>
        <div style="font-size:.8rem; opacity:.7;">Limiter OK</div>
        <strong>@(Model.RuntimeReadiness.LimiterOk ? "yes" : "no")</strong>
      </div>
      <div>
        <div style="font-size:.8rem; opacity:.7;">Overall runtime OK</div>
        <strong>@(Model.RuntimeReadiness.Ok ? "yes" : "no")</strong>
      </div>
      <div>
        <div style="font-size:.8rem; opacity:.7;">Redis required</div>
        <strong>@(Model.RuntimeReadiness.RedisRequired ? "yes" : "no")</strong>
      </div>
      <div>
        <div style="font-size:.8rem; opacity:.7;">Redis configured</div>
        <strong>@(Model.RuntimeReadiness.RedisConfigured ? "yes" : "no")</strong>
      </div>
      <div>
        <div style="font-size:.8rem; opacity:.7;">Redis reachable</div>
        <strong>@redisReachable</strong>
      </div>
    </div>
    <p style="margin:10px 0 0 0; opacity:.8;">Reason: @Model.RuntimeReadiness.RedisReason | Missing checks: @Model.RuntimeReadiness.MissingCount | Warnings: @Model.RuntimeReadiness.WarningCount</p>
  }
</section>

@{
  var tariffOptions = new[] { "free", "active", "trialing", "past_due", "canceled", "incomplete", "unpaid" };
  var globalUserRows = Model.GlobalUsers.Select(u =>
  {
    var options = tariffOptions
      .Select(option => new EditableTableOptionViewModel
      {
        Value = option,
        Label = option,
        Selected = string.Equals(option, u.SubscriptionStatus, StringComparison.OrdinalIgnoreCase),
      })
      .ToList();

    if (!tariffOptions.Contains((u.SubscriptionStatus ?? string.Empty).Trim(), StringComparer.OrdinalIgnoreCase))
    {
      options.Add(new EditableTableOptionViewModel
      {
        Value = u.SubscriptionStatus ?? string.Empty,
        Label = u.SubscriptionStatus ?? string.Empty,
        Selected = true,
      });
    }

    return new EditableTableRowViewModel
    {
      RowKey = u.UserId.ToString("N"),
      Cells = new List<EditableTableCellViewModel>
      {
        new() { Kind = EditableTableCellKind.Text, Text = u.DisplayName },
        new() { Kind = EditableTableCellKind.Text, Text = u.GlobalRole },
        new()
        {
          Kind = EditableTableCellKind.Select,
          Name = "subscriptionStatus",
          CssClass = "inline-input",
          Options = options,
        },
        new() { Kind = EditableTableCellKind.Code, Text = u.UserId.ToString() },
      },
      PrimaryAction = new EditableTableActionViewModel
      {
        ActionUrl = $"/ops/users/{u.UserId}/subscription",
        SubmitLabel = "Save",
        SubmitButtonClass = "vo-btn vo-btn-secondary",
      },
    };
  }).ToList();
}

@await Html.PartialAsync("~/Views/Shared/Ui/_EditableTable.cshtml", new EditableTableViewModel
{
  Title = "Global Users",
  Columns = new[] { "User", "Global Role", "Tariff Plan", "User ID" },
  EmptyMessage = "No global users found.",
  Rows = globalUserRows,
})

@await Html.PartialAsync("~/Views/Shared/Ui/_DataTableShell.cshtml", new DataTableShellViewModel {
  Title = "Recent Activity Log",
  Columns = new[] { "When", "Action", "Entity", "Entity Id", "User", "Org" },
  EmptyMessage = "No recent activity found.",
  Rows = Model.RecentAuditLogs
    .Select(l => (IReadOnlyList<string>)new[] {
      l.Timestamp.ToString("yyyy-MM-dd HH:mm:ss"),
      l.Action,
      l.EntityType,
      l.EntityId,
      l.UserId?.ToString() ?? "-",
      l.OrganizationId?.ToString() ?? "-",
    })
    .ToList()
})

<script>
  setTimeout(function () {
    window.location.reload();
  }, 30000);
</script>
