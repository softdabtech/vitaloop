@model CreateOrganizationViewModel
@{
    ViewData["Title"] = "Create Organization";
    Layout = "_CrmLayout";
}

<div class="container-narrow">
    <div class="page-header">
        <h1 class="page-title">Create Organization</h1>
        <p class="page-subtitle">Set up a new CRM organization</p>
    </div>

    <form method="post" class="form-org-create">
        <div class="form-card">
            <div class="form-section">
                <label class="form-label" for="Name">
                    Organization Name
                    <span class="required">*</span>
                </label>
                <input 
                    type="text"
                    id="Name"
                    name="Name"
                    class="form-control"
                    placeholder="e.g. Acme Health"
                    value="@Model?.Name"
                    required />
                <span class="form-hint">The display name for your organization</span>
            </div>

            <div class="form-section">
                <label class="form-label" for="Slug">
                    URL Slug
                    <span class="required">*</span>
                </label>
                <input 
                    type="text"
                    id="Slug"
                    name="Slug"
                    class="form-control"
                    placeholder="e.g. acme-health"
                    value="@Model?.Slug"
                    required
                    pattern="[a-z0-9-]+"
                    title="Lowercase letters, numbers, and hyphens only" />
                <span class="form-hint">URL-friendly identifier (lowercase, hyphens)</span>
            </div>

            <div class="form-section">
                <label class="form-label" for="Description">Organization Description</label>
                <textarea 
                    id="Description"
                    name="Description"
                    class="form-control"
                    placeholder="Optional description..."
                    rows="3">@Model?.Description</textarea>
                <span class="form-hint">Internal notes about the organization</span>
            </div>

            <div class="form-section">
                <label class="form-label" for="LogoUrl">Logo URL</label>
                <input 
                    type="url"
                    id="LogoUrl"
                    name="LogoUrl"
                    class="form-control"
                    placeholder="https://example.com/logo.png"
                    value="@Model?.LogoUrl" />
                <span class="form-hint">Public URL to organization logo</span>
            </div>

            <div class="form-section">
                <label class="form-label" for="Status">Status</label>
                <select id="Status" name="Status" class="form-control">
                    <option value="active" selected>Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <div class="form-section">
                <label class="form-label" for="OwnerEmail">
                    Organization Owner Email
                    <span class="required">*</span>
                </label>
                <input 
                    type="email"
                    id="OwnerEmail"
                    name="OwnerEmail"
                    class="form-control"
                    placeholder="admin@example.com"
                    value="@Model?.OwnerEmail"
                    required />
                <span class="form-hint">Email of the user who will own this organization</span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-lg">Create Organization</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">Cancel</a>
        </div>
    </form>
</div>

<style>
    .container-narrow {
        max-width: 600px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .form-card {
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 2rem;
        margin: 2rem 0;
    }

    .form-section {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    .required {
        color: #ef4444;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        font-size: 1rem;
        font-family: inherit;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .form-hint {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.85rem;
        color: var(--color-text-secondary);
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn-lg {
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
    }
</style>
