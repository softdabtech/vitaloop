@model OrganizationsPageViewModel
@{
    ViewData["Title"] = "Organizations";
    Layout = "_CrmLayout";
}

<div class="container-page">
    <div class="page-header">
        <div class="page-title-group">
            <h1 class="page-title">Organizations</h1>
            <p class="page-subtitle">Manage CRM organizations and permissions</p>
        </div>
        @if (Model?.IsSuperAdmin == true)
        {
            <a href="@Model.CreateOrgUrl" class="btn btn-primary">
                <span class="btn-icon">➕</span> Create Organization
            </a>
        }
    </div>

    @{
        var rows = (Model?.Organizations ?? Array.Empty<OrganizationViewModel>())
            .Select(org => new EditableTableRowViewModel
            {
                RowKey = org.Id.ToString("N"),
                Cells = new List<EditableTableCellViewModel>
                {
                    new() { Kind = EditableTableCellKind.Text, Text = org.Name },
                    new() { Kind = EditableTableCellKind.Code, Text = org.Slug },
                    new() { Kind = EditableTableCellKind.Text, Text = org.OwnerName },
                    new()
                    {
                        Kind = EditableTableCellKind.Select,
                        Name = "status",
                        CssClass = "inline-input",
                        Options = new List<EditableTableOptionViewModel>
                        {
                            new() { Value = "active", Label = "active", Selected = string.Equals(org.Status, "active", StringComparison.OrdinalIgnoreCase) },
                            new() { Value = "inactive", Label = "inactive", Selected = string.Equals(org.Status, "inactive", StringComparison.OrdinalIgnoreCase) },
                            new() { Value = "suspended", Label = "suspended", Selected = string.Equals(org.Status, "suspended", StringComparison.OrdinalIgnoreCase) },
                        }
                    },
                },
                PrimaryAction = new EditableTableActionViewModel
                {
                    ActionUrl = $"/admin/organizations/{org.Id}/status",
                    SubmitLabel = "Save Status",
                },
                SecondaryActions = new List<EditableTableActionViewModel>
                {
                    new()
                    {
                        ActionUrl = $"/admin/organizations/{org.Id}",
                        Method = "get",
                        SubmitLabel = "Details",
                        SubmitButtonClass = "btn btn-xs btn-secondary",
                    },
                    new()
                    {
                        ActionUrl = $"/admin/orgs/{org.Id}/switch?returnUrl=%2Fadmin%2Forganizations",
                        Method = "get",
                        SubmitLabel = "Switch",
                    },
                    new()
                    {
                        ActionUrl = "/admin/members",
                        Method = "get",
                        SubmitLabel = "Team",
                    },
                    new()
                    {
                        ActionUrl = $"/admin/orgs/{org.Id}/switch?returnUrl=%2Forganizations%2Fsettings%3Forg_id%3D{org.Id}",
                        Method = "get",
                        SubmitLabel = "Settings",
                    },
                }
            })
            .ToList();
    }

    @await Html.PartialAsync("~/Views/Shared/Ui/_EditableTable.cshtml", new EditableTableViewModel
    {
        Title = "Organizations",
        Columns = new[] { "Name", "Slug", "Owner", "Status" },
        EmptyMessage = "You don't have access to any organizations yet.",
        Rows = rows,
    })

    @if ((Model?.Organizations.Count ?? 0) == 0 && Model?.IsSuperAdmin == true)
    {
        <div class="empty-state" style="padding-top: 0;">
            <a href="@Model.CreateOrgUrl" class="btn btn-primary btn-lg">Create Your First Organization</a>
        </div>
    }
</div>

<style>
    .btn {
        padding: 0.5rem 1rem;
        border-radius: 4px;
        font-size: 0.875rem;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-block;
    }

    .btn-primary {
        background: var(--color-primary);
        color: white;
    }

    .btn-secondary {
        background: var(--color-bg);
        color: var(--color-text);
        border: 1px solid var(--color-border);
    }

    .btn-outline {
        background: transparent;
        color: var(--color-primary);
        border: 1px solid var(--color-primary);
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
    }

    .empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }
</style>
