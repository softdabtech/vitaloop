@model MemberViewModel
@{
    ViewData["Title"] = "Member Profile";
    Layout = "_CrmLayout";
    var statusClass = string.Equals(Model.MembershipStatus, "active", StringComparison.OrdinalIgnoreCase) ? "tag-teal" : "tag-gray";
    var tariffClass = Model.SubscriptionStatus switch {
        "active" or "trialing" => "tag-teal",
        "past_due" or "unpaid" => "tag-red",
        "canceled" => "tag-amber",
        _ => "tag-gray"
    };
}

<style>
.profile-wrap { padding:24px; max-width:980px; }
.profile-head { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; flex-wrap:wrap; margin-bottom:18px; }
.profile-title { margin:0; color:#0f172a; font-size:24px; font-weight:900; letter-spacing:-.02em; }
.profile-sub { margin:6px 0 0; color:#64748b; font-size:13px; }
.profile-grid { display:grid; grid-template-columns:1.1fr .9fr; gap:18px; align-items:start; }
.profile-card { background:#fff; border:1px solid #e8ecf2; border-radius:14px; padding:20px; box-shadow:0 14px 34px rgba(15,23,42,.05); }
.profile-avatar { width:58px; height:58px; border-radius:18px; background:linear-gradient(135deg,#14b8a6,#1d9e75); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:900; font-size:20px; }
.profile-identity { display:flex; gap:14px; align-items:center; }
.profile-name { margin:0; color:#0f172a; font-size:20px; font-weight:800; }
.profile-email { color:#64748b; font-size:13px; margin-top:3px; word-break:break-all; }
.tag { display:inline-flex; align-items:center; padding:3px 10px; border-radius:20px; font-size:12px; font-weight:700; }
.tag-teal { background:#d1fae5; color:#065f46; }
.tag-blue { background:#dbeafe; color:#1e40af; }
.tag-amber { background:#fef3c7; color:#92400e; }
.tag-red { background:#fee2e2; color:#991b1b; }
.tag-gray { background:#f1f5f9; color:#475569; }
.kv { display:grid; gap:12px; margin-top:18px; }
.kv-row { display:flex; justify-content:space-between; gap:14px; padding:12px 0; border-bottom:1px solid #f1f5f9; }
.kv-row:last-child { border-bottom:0; }
.kv-label { color:#94a3b8; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.06em; }
.kv-value { color:#0f172a; font-size:14px; font-weight:700; text-align:right; }
.form-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.field { display:flex; flex-direction:column; gap:6px; }
.field label { color:#475569; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.05em; }
.field input, .field select { border:1px solid #e2e8f0; border-radius:10px; padding:10px 12px; color:#0f172a; font-size:14px; outline:none; background:#fff; }
.field input:focus, .field select:focus { border-color:#1d9e75; box-shadow:0 0 0 3px rgba(29,158,117,.12); }
.actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:18px; }
.btn { border:0; border-radius:10px; padding:10px 16px; font-size:13px; font-weight:800; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; }
.btn-primary { background:#1d9e75; color:#fff; }
.btn-primary:hover { background:#0f6e56; }
.btn-secondary { background:#f1f5f9; color:#475569; }
.btn-secondary:hover { background:#e2e8f0; }
@@media (max-width:820px) {
  .profile-wrap { padding:16px; }
  .profile-grid { grid-template-columns:1fr; }
  .form-grid { grid-template-columns:1fr; }
}
</style>

<div class="profile-wrap">
  <div class="profile-head">
    <div>
      <h1 class="profile-title">Member Profile</h1>
      <p class="profile-sub">Review and update the member context used by CRM workflows.</p>
    </div>
    <a href="/admin/members" class="btn btn-secondary">Back to members</a>
  </div>

  <div class="profile-grid">
    <section class="profile-card">
      <div class="profile-identity">
        <div class="profile-avatar">@Model.DisplayName.Trim().Substring(0, 1).ToUpperInvariant()</div>
        <div>
          <h2 class="profile-name">@Model.DisplayName</h2>
          <div class="profile-email">@Model.Email</div>
        </div>
      </div>

      <div class="kv">
        <div class="kv-row">
          <span class="kv-label">User ID</span>
          <span class="kv-value" style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px">@Model.UserId</span>
        </div>
        <div class="kv-row">
          <span class="kv-label">Organization role</span>
          <span class="kv-value"><span class="tag tag-blue">@Model.OrgRole</span></span>
        </div>
        <div class="kv-row">
          <span class="kv-label">Membership</span>
          <span class="kv-value"><span class="tag @statusClass">@Model.MembershipStatus</span></span>
        </div>
        <div class="kv-row">
          <span class="kv-label">Subscription</span>
          <span class="kv-value"><span class="tag @tariffClass">@(string.IsNullOrWhiteSpace(Model.SubscriptionStatus) ? "free" : Model.SubscriptionStatus)</span></span>
        </div>
        <div class="kv-row">
          <span class="kv-label">Global role</span>
          <span class="kv-value">@Model.GlobalRole</span>
        </div>
      </div>
    </section>

    <section class="profile-card">
      <h2 style="margin:0 0 14px;color:#0f172a;font-size:18px;font-weight:900;">Editable profile</h2>
      <form method="post" action="/admin/members/@Model.UserId/profile">
        @Html.AntiForgeryToken()
        <div class="form-grid">
          <div class="field" style="grid-column:1 / -1">
            <label for="fullName">Full name</label>
            <input id="fullName" name="fullName" value="@Model.FullName" placeholder="Full name" />
          </div>
          <div class="field">
            <label for="age">Age</label>
            <input id="age" name="age" type="number" min="0" max="130" value="@Model.Age" placeholder="Age" />
          </div>
          <div class="field">
            <label for="sex">Sex</label>
            <select id="sex" name="sex">
              <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Sex) ? "selected" : null)">Not set</option>
              <option value="m" selected="@(string.Equals(Model.Sex, "m", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">m</option>
              <option value="f" selected="@(string.Equals(Model.Sex, "f", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">f</option>
              <option value="male" selected="@(string.Equals(Model.Sex, "male", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">male</option>
              <option value="female" selected="@(string.Equals(Model.Sex, "female", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">female</option>
            </select>
          </div>
          <div class="field" style="grid-column:1 / -1">
            <label for="subscriptionStatus">Subscription status</label>
            <select id="subscriptionStatus" name="subscriptionStatus">
              @foreach (var s in new[] { "free", "active", "trialing", "past_due", "unpaid", "canceled" })
              {
                <option value="@s" selected="@(string.Equals(Model.SubscriptionStatus, s, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@s</option>
              }
            </select>
          </div>
        </div>
        <div class="actions">
          <button type="submit" class="btn btn-primary">Save profile</button>
          <a href="/admin/members" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </section>
  </div>
</div>
