@model MembersPageViewModel
@{
    ViewData["Title"] = "Team Members";
    Layout = "_CrmLayout";
}

@await Html.PartialAsync("~/Views/Shared/Partials/_Breadcrumbs.cshtml")
<div class="container-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Team Members</h1>
            <p class="page-subtitle">Manage your organization's team</p>
        </div>
        <a href="@Url.Action("Invite")" class="btn btn-primary">
            <span class="btn-icon">➕</span> Invite Member
        </a>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <span class="stat-label">Total Members</span>
            <span class="stat-value">@Model?.TotalMembers</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Practitioners</span>
            <span class="stat-value">@Model?.PractitionerCount</span>
        </div>
    </div>

    @if (Model?.Members.Any() == true)
    {
        var rows = Model.Members.Select(member => new EditableTableRowViewModel
        {
            RowKey = member.UserId.ToString("N"),
            Cells = new List<EditableTableCellViewModel>
            {
                new() { Kind = EditableTableCellKind.Text, Text = string.IsNullOrWhiteSpace(member.FullName) ? member.Email : member.FullName },
                new() { Kind = EditableTableCellKind.Code, Text = member.Email },
                new() { Kind = EditableTableCellKind.Text, Text = (member.Age?.ToString() ?? "-") + " / " + (!string.IsNullOrWhiteSpace(member.Sex) ? member.Sex : "-") },
                new() { Kind = EditableTableCellKind.Badge, Text = member.OrgRole, BadgeTone = string.Equals(member.OrgRole, "practitioner", StringComparison.OrdinalIgnoreCase) ? "primary" : "secondary" },
                new() { Kind = EditableTableCellKind.Badge, Text = member.MembershipStatus, BadgeTone = string.Equals(member.MembershipStatus, "active", StringComparison.OrdinalIgnoreCase) ? "success" : "warning" },
                new()
                {
                    Kind = EditableTableCellKind.Select,
                    Name = "subscriptionStatus",
                    CssClass = "inline-input",
                    Options = new List<EditableTableOptionViewModel>
                    {
                        new() { Value = "free", Label = "free", Selected = string.Equals(member.SubscriptionStatus, "free", StringComparison.OrdinalIgnoreCase) },
                        new() { Value = "active", Label = "active", Selected = string.Equals(member.SubscriptionStatus, "active", StringComparison.OrdinalIgnoreCase) },
                        new() { Value = "past_due", Label = "past_due", Selected = string.Equals(member.SubscriptionStatus, "past_due", StringComparison.OrdinalIgnoreCase) },
                        new() { Value = "cancelled", Label = "cancelled", Selected = string.Equals(member.SubscriptionStatus, "cancelled", StringComparison.OrdinalIgnoreCase) },
                    }
                },
            },
            PrimaryAction = new EditableTableActionViewModel
            {
                ActionUrl = $"/admin/members/{member.UserId}/profile",
                SubmitLabel = "Save Profile",
                Fields = new List<EditableTableFieldViewModel>
                {
                    new() { Kind = EditableTableFieldKind.Text, Name = "fullName", Value = member.FullName, Placeholder = "Full name", CssClass = "inline-input" },
                    new() { Kind = EditableTableFieldKind.Number, Name = "age", Value = member.Age?.ToString() ?? string.Empty, Placeholder = "Age", CssClass = "inline-input inline-input-small" },
                    new()
                    {
                        Kind = EditableTableFieldKind.Select,
                        Name = "sex",
                        CssClass = "inline-input inline-input-small",
                        Options = new List<EditableTableOptionViewModel>
                        {
                            new() { Value = string.Empty, Label = "-", Selected = string.IsNullOrWhiteSpace(member.Sex) },
                            new() { Value = "m", Label = "m", Selected = string.Equals(member.Sex, "m", StringComparison.OrdinalIgnoreCase) },
                            new() { Value = "f", Label = "f", Selected = string.Equals(member.Sex, "f", StringComparison.OrdinalIgnoreCase) },
                        }
                    },
                }
            },
            SecondaryActions = new List<EditableTableActionViewModel>
            {
                new()
                {
                    ActionUrl = $"/admin/members/{member.UserId}/role",
                    SubmitLabel = "Change Role",
                    Fields = new List<EditableTableFieldViewModel>
                    {
                        new()
                        {
                            Kind = EditableTableFieldKind.Select,
                            Name = "newRole",
                            CssClass = "inline-input",
                            Options = new List<EditableTableOptionViewModel>
                            {
                                new() { Value = "org_owner", Label = "org_owner", Selected = string.Equals(member.OrgRole, "org_owner", StringComparison.OrdinalIgnoreCase) },
                                new() { Value = "client_admin", Label = "client_admin", Selected = string.Equals(member.OrgRole, "client_admin", StringComparison.OrdinalIgnoreCase) },
                                new() { Value = "manager", Label = "manager", Selected = string.Equals(member.OrgRole, "manager", StringComparison.OrdinalIgnoreCase) },
                                new() { Value = "practitioner", Label = "practitioner", Selected = string.Equals(member.OrgRole, "practitioner", StringComparison.OrdinalIgnoreCase) },
                                new() { Value = "support", Label = "support", Selected = string.Equals(member.OrgRole, "support", StringComparison.OrdinalIgnoreCase) },
                                new() { Value = "member", Label = "member", Selected = string.Equals(member.OrgRole, "member", StringComparison.OrdinalIgnoreCase) },
                            }
                        },
                    }
                },
                new()
                {
                    ActionUrl = $"/admin/members/{member.UserId}/remove",
                    SubmitLabel = "Remove",
                    SubmitButtonClass = "btn btn-xs btn-danger",
                    ConfirmMessage = "Remove this member from organization?"
                },
            }
        }).ToList();

        @await Html.PartialAsync("~/Views/Shared/Ui/_EditableTable.cshtml", new EditableTableViewModel
        {
            Title = "Team Members",
            Columns = new[] { "Name", "Email", "Age/Sex", "Role", "Status", "Subscription" },
            EmptyMessage = "No team members found.",
            Rows = rows,
        })
    }
    else
    {
        <div class="empty-state">
            <p class="empty-icon">👥</p>
            <h2>No Team Members</h2>
            <p>Start by inviting your first team member.</p>
            <a href="@Url.Action("Invite")" class="btn btn-primary btn-lg">Invite Team Member</a>
        </div>
    }
</div>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-primary);
    }

    .table-container {
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        overflow: hidden;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

    .table th {
        background: var(--color-bg);
        padding: 1rem;
        text-align: left;
        font-weight: 600;
        font-size: 0.875rem;
        border-bottom: 1px solid var(--color-border);
    }

    .table td {
        padding: 1rem;
        border-bottom: 1px solid var(--color-border);
    }

    .table tbody tr:hover {
        background: rgba(0,0,0,0.02);
    }

    .table code {
        background: var(--color-bg);
        padding: 0.25rem 0.5rem;
        border-radius: 3px;
        font-size: 0.85rem;
    }

    .badge {
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .badge-primary {
        background: rgba(59, 130, 246, 0.1);
        color: #3b82f6;
    }

    .badge-secondary {
        background: rgba(107, 114, 128, 0.1);
        color: #6b7280;
    }

    .badge-success {
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
    }

    .badge-warning {
        background: rgba(234, 179, 8, 0.1);
        color: #eab308;
    }

    .btn {
        padding: 0.5rem 1rem;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
    }

    .btn-primary {
        background: var(--color-primary);
        color: white;
    }

    .btn-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.7rem;
    }

    .btn-outline {
        background: transparent;
        color: var(--color-primary);
        border: 1px solid var(--color-primary);
    }

    .btn-lg {
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 320px;
    }

    .inline-form {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .inline-input {
        min-width: 90px;
        padding: 0.3rem 0.45rem;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .inline-input-small {
        width: 64px;
        min-width: 64px;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
    }

    .empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }
</style>
