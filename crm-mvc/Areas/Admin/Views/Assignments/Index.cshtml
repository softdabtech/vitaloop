@model AssignmentsPageViewModel
@{
    ViewData["Title"] = "Practitioner Assignments";
    Layout = "_CrmLayout";
}

<div class="container-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Practitioner Assignments</h1>
            <p class="page-subtitle">Manage specialist → client relationships</p>
        </div>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <span class="btn-icon">➕</span> New Assignment
        </a>
    </div>

    @if (Model?.Assignments.Any() == true)
    {
        <div class="table-container">
            <table class="table table-members">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Practitioner</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assignment in Model.Assignments)
                    {
                        <tr>
                            <td>@(!string.IsNullOrWhiteSpace(assignment.ClientName) ? assignment.ClientName : assignment.ClientId.ToString())</td>
                            <td>@(!string.IsNullOrWhiteSpace(assignment.PractitionerName) ? assignment.PractitionerName : assignment.PractitionerId.ToString())</td>
                            <td>
                                <span class="badge badge-@(assignment.Status == "active" ? "success" : "warning")">@assignment.Status</span>
                            </td>
                            <td>@assignment.Notes</td>
                            <td>@assignment.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <div class="action-buttons">
                                    <form method="post" action="/admin/assignments/@assignment.Id/update" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <select name="status" class="inline-input">
                                            <option value="active" selected="@(string.Equals(assignment.Status, "active", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">active</option>
                                            <option value="paused" selected="@(string.Equals(assignment.Status, "paused", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">paused</option>
                                            <option value="completed" selected="@(string.Equals(assignment.Status, "completed", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">completed</option>
                                            <option value="cancelled" selected="@(string.Equals(assignment.Status, "cancelled", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">cancelled</option>
                                        </select>
                                        <input type="text" name="notes" value="@assignment.Notes" class="inline-input" placeholder="Notes" />
                                        <button type="submit" class="btn btn-xs btn-outline">Save</button>
                                    </form>

                                    <form method="post" action="/admin/assignments/@assignment.Id/reassign" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <select name="newPractitionerId" class="inline-input">
                                            @foreach (var practitioner in Model.PractitionerOptions)
                                            {
                                                <option value="@practitioner.UserId" selected="@(practitioner.UserId == assignment.PractitionerId ? "selected" : null)">
                                                    @practitioner.DisplayName
                                                </option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-xs btn-outline">Reassign</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p class="empty-icon">🔗</p>
            <h2>No Assignments</h2>
            <p>Create your first practitioner-client assignment.</p>
            <a href="@Url.Action("Create")" class="btn btn-primary btn-lg">Create Assignment</a>
        </div>
    }
</div>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .table-container {
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        overflow: auto;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

    .table th,
    .table td {
        border-bottom: 1px solid var(--color-border);
        padding: 0.75rem;
        vertical-align: top;
    }

    .table th {
        background: var(--color-bg);
        font-size: 0.85rem;
        text-align: left;
    }

    .badge {
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .badge-success {
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
    }

    .badge-warning {
        background: rgba(234, 179, 8, 0.1);
        color: #eab308;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        min-width: 280px;
    }

    .inline-form {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .inline-input {
        min-width: 90px;
        padding: 0.3rem 0.45rem;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .btn {
        padding: 0.5rem 0.75rem;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-size: 0.75rem;
    }

    .btn-sm {
        padding: 0.375rem 0.75rem;
    }

    .btn-outline {
        background: transparent;
        color: var(--color-primary);
        border: 1px solid var(--color-primary);
    }

    .btn-danger {
        background: #ef4444;
        color: white;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
    }

    .empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }
</style>
