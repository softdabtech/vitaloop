@{
  ViewData["Title"] = "Forgot Password";
  Layout = "_BlankLayout";
}

<div class="vo-blank-wrap">
  <section class="vo-auth-card">
    <p class="vo-eyebrow">Vitaloop CRM</p>
    <h2 class="vo-page-title">Reset password</h2>
    <p class="vo-page-subtitle">Enter your email to receive a reset link.</p>

    <form class="vo-form-grid" method="post" action="#">
      <div class="vo-field">
        <label class="vo-label" for="fp-email">Email</label>
        <input id="fp-email" type="email" class="vo-input" name="email" placeholder="you@example.com" autocomplete="email" />
      </div>
      <div class="vo-form-actions">
        <button type="submit" class="vo-btn vo-btn-primary">Send reset link</button>
        <a class="vo-btn vo-btn-ghost" href="/auth/login">Back to sign in</a>
      </div>
    </form>
  </section>
</div>
