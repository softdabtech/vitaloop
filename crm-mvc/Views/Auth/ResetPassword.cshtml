@{
  ViewData["Title"] = "Set New Password";
  Layout = "_BlankLayout";
}

<div class="vo-blank-wrap">
  <section class="vo-auth-card">
    <p class="vo-eyebrow">Vitaloop CRM</p>
    <h2 class="vo-page-title">Set a new password</h2>
    <p class="vo-page-subtitle">Choose a strong password to secure your account.</p>

    <form class="vo-form-grid" method="post" action="#">
      <div class="vo-field">
        <label class="vo-label" for="rp-pass">New password</label>
        <input id="rp-pass" type="password" class="vo-input" name="password" placeholder="Minimum 8 characters" autocomplete="new-password" />
      </div>
      <div class="vo-field">
        <label class="vo-label" for="rp-confirm">Confirm password</label>
        <input id="rp-confirm" type="password" class="vo-input" name="confirmPassword" placeholder="Repeat password" autocomplete="new-password" />
      </div>
      <div class="vo-form-actions">
        <button type="submit" class="vo-btn vo-btn-primary">Update password</button>
      </div>
    </form>
  </section>
</div>
