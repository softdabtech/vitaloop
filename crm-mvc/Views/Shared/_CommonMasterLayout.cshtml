<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Vitaloop CRM — practitioner and organization management" />
  <meta name="robots" content="noindex, nofollow" />
  <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | Vitaloop CRM" : "Vitaloop CRM")</title>

  <link rel="icon" type="image/jpeg" href="~/logo_2.jpg" asp-append-version="true" />

  <link rel="stylesheet" href="~/css/vitaloop-theme.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/vitaloop-shell.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

  @await RenderSectionAsync("PageStyles", required: false)
</head>
<body class="vo-body">
  @RenderBody()

  <script src="~/js/app.js" asp-append-version="true"></script>
  @await RenderSectionAsync("PageScripts", required: false)
</body>
</html>
