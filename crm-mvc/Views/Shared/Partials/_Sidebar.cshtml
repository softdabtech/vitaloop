@using System.Linq
@model UserContext?
@{
  var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;
  var activeMembership = Model?.ActiveOrganizationId.HasValue == true
    ? Model.Memberships.FirstOrDefault(m => m.OrganizationId == Model.ActiveOrganizationId.Value)
    : null;

  var isSuperAdmin = string.Equals(Model?.GlobalRole, "super_admin", StringComparison.OrdinalIgnoreCase);
  var isOrgAdmin = activeMembership != null && 
    (string.Equals(activeMembership.Role, "org_owner", StringComparison.OrdinalIgnoreCase) ||
     string.Equals(activeMembership.Role, "client_admin", StringComparison.OrdinalIgnoreCase));
  var isManager = activeMembership != null &&
    string.Equals(activeMembership.Role, "manager", StringComparison.OrdinalIgnoreCase);
  var isPractitioner = activeMembership != null && 
    string.Equals(activeMembership.Role, "practitioner", StringComparison.OrdinalIgnoreCase);

  var navItemsOverview = new[]
  {
    new { Href = "/admin",         Label = "Dashboard",     Group = "Overview",  Icon = "&#127968;", RequireRole = new[] { "org_admin", "manager" } },
    new { Href = "/practitioner/clients", Label = "My Clients", Group = "Overview", Icon = "&#129658;", RequireRole = new[] { "practitioner" } },
    new { Href = "/ops",           Label = "Ops",           Group = "Overview",  Icon = "&#128202;", RequireRole = new[] { "super_admin" } },
    new { Href = "/ops/activity",  Label = "Activity Log",  Group = "Overview",  Icon = "&#129534;", RequireRole = new[] { "super_admin" } }
  };

  var navItemsCrm = new[]
  {
    new { Href = "/admin/organizations", Label = "Organizations", Group = "CRM", Icon = "&#127962;", RequireRole = new[] { "super_admin", "org_admin" } },
    new { Href = "/admin/members",       Label = "Team Members",   Group = "CRM", Icon = "&#128101;", RequireRole = new[] { "org_admin", "manager" } },
    new { Href = "/admin/members/invite", Label = "Invitations",   Group = "CRM", Icon = "&#9993;",  RequireRole = new[] { "org_admin" } },
    new { Href = "/admin/assignments",   Label = "Assignments",    Group = "CRM", Icon = "&#128279;", RequireRole = new[] { "org_admin", "manager", "practitioner" } }
  };

  var navItemsAccount = new[]
  {
    new { Href = "/billing",       Label = "Billing",        Group = "Account", Icon = "&#128179;", RequireRole = new[] { "org_admin" } },
    new { Href = "/settings",      Label = "Settings",       Group = "Account", Icon = "&#9881;",  RequireRole = new string[0] }
  };

  bool ShouldShowItem(string[] requiredRoles)
  {
    if (requiredRoles.Length == 0) return true;
    if (isSuperAdmin) return true;
    return requiredRoles.Any(role => role switch
    {
      "super_admin" => isSuperAdmin,
      "org_admin" => isOrgAdmin,
      "manager" => isOrgAdmin || isManager,
      "practitioner" => isOrgAdmin || isManager || isPractitioner,
      _ => false,
    });
  }

  var allItems = new[] { navItemsOverview, navItemsCrm, navItemsAccount }.SelectMany(x => x).ToArray();
  var visibleItems = allItems.Where(item => ShouldShowItem(item.RequireRole)).ToArray();

  var activeItemHref = visibleItems
    .Where(item =>
      currentPath == item.Href ||
      (item.Href.Length > 1 && currentPath.StartsWith(item.Href + "/", StringComparison.OrdinalIgnoreCase)))
    .OrderByDescending(item => item.Href.Length)
    .Select(item => item.Href)
    .FirstOrDefault() ?? string.Empty;
}

<aside class="vo-sidebar" id="vo-sidebar" aria-label="Main navigation">
  <div class="vo-brand">
    <a href="/admin" class="vo-brand-link" aria-label="VITALOOP CRM home">
      <span class="vo-brand-mark">VL</span>
      <span class="vo-brand-text">Vitaloop</span>
    </a>
    <button class="vo-sidebar-toggle" type="button" aria-label="Toggle sidebar">&#10005;</button>
  </div>

  <div class="vo-identity-block">
    @if (Model is null)
    {
      <p class="vo-identity-line">Guest session</p>
      <p class="vo-identity-sub">Not authenticated</p>
    }
    else
    {
      <p class="vo-identity-line">@Model.Email</p>
      <p class="vo-identity-sub">
        @(isSuperAdmin ? "🔑 Super Admin" : activeMembership?.Role ?? "Member")
      </p>
      
      @if (Model.Memberships.Count > 0)
      {
        <div class="vo-org-selector">
          <select class="vo-org-select" onchange="location.href = this.value">
            @if (!Model.ActiveOrganizationId.HasValue)
            {
              <option value="" selected>Select Organization...</option>
            }
            @foreach (var membership in Model.Memberships)
            {
              var selected = membership.OrganizationId == Model.ActiveOrganizationId;
              if (selected)
              {
                <option value="/admin/orgs/@membership.OrganizationId/switch" selected>
                  @membership.OrganizationName
                </option>
              }
              else
              {
                <option value="/admin/orgs/@membership.OrganizationId/switch">
                  @membership.OrganizationName
                </option>
              }
            }
          </select>
        </div>
      }
    }
  </div>

  @foreach (var group in visibleItems.GroupBy(x => x.Group).OrderBy(g => g.Key == "Overview" ? 0 : (g.Key == "CRM" ? 1 : 2)))
  {
    <div class="vo-nav-group">
      <p class="vo-nav-group-title">@group.Key</p>
      <ul class="vo-nav-list">
        @foreach (var item in group)
        {
          var active = string.Equals(activeItemHref, item.Href, StringComparison.OrdinalIgnoreCase);
          <li>
            <a class="vo-nav-link @(active ? "is-active" : string.Empty)"
               href="@item.Href"
               aria-current="@(active ? "page" : null)">
              <span class="vo-nav-icon" aria-hidden="true">@Html.Raw(item.Icon)</span>
              @item.Label
            </a>
          </li>
        }
      </ul>
    </div>
  }

  <div class="vo-sidebar-footer">
    <a class="vo-nav-link" href="/auth/logout">
      <span class="vo-nav-icon" aria-hidden="true">&#128275;</span>
      Log out
    </a>
  </div>
</aside>

<style>
  .vo-org-selector {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .vo-org-select {
    width: 100%;
    padding: 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
    color: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .vo-org-select:hover,
  .vo-org-select:focus {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
  }
</style>

