{
  "name": "vitaloop-frontend",
  "private": true,
  "version": "4.1.1",
  "type": "module",
  "homepage": "https://vitaloop.softdab.tech",
  "scripts": {
    "dev": "vite",
    "validate:env": "node ./scripts/validate-env.mjs",
    "build": "npm run validate:env && vite build",
    "build:prod": "npm run validate:env && NODE_OPTIONS=--max-old-space-size=2048 vite build --mode production",
    "postbuild": "react-snap",
    "postbuild:prod": "react-snap",
    "preview": "vite preview",
    "qa:routes": "node ./scripts/qa-routes-links.mjs",
    "qa:endpoints": "node ./scripts/qa-endpoints.mjs",
    "qa": "npm run qa:routes && npm run qa:endpoints",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix"
  },
  "reactSnap": {
    "source": "dist",
    "include": [
      "/",
      "/how-it-works",
      "/example-report"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "dependencies": {
    "@21st-sdk/agent": "^0.0.16",
    "@21st-sdk/nextjs": "^0.0.11",
    "@21st-sdk/node": "^0.0.10",
    "@21st-sdk/react": "^0.2.3",
    "@ai-sdk/react": "^3.0.170",
    "@sentry/react": "^10.48.0",
    "@stripe/stripe-js": "^3.4.1",
    "@supabase/supabase-js": "^2.43.4",
    "@tanstack/react-query": "^5.100.5",
    "ai": "^6.0.168",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.8.0",
    "pdfjs-dist": "^4.3.136",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-dropzone": "^14.2.3",
    "react-google-recaptcha": "^3.1.0",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "tesseract.js": "^5.1.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.38",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  }
}
