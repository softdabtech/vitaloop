# Multi-stage production build for frontend
#
# Vite bakes VITE_* vars into the JS bundle at build time. Provide them either
# way: (a) --build-arg on `docker build` / docker-compose `build.args` (wins,
# takes precedence as a real env var), or (b) a frontend/.env.production file
# in the build context (picked up by Vite's own dotenv loading). Missing
# required vars fail fast in `npm run build` via validate-env.mjs — that's
# intentional, don't silence it.
#
# IMPORTANT: whatever this stage produces IS what ships. There must be no
# `./frontend/dist:...` volume mount in docker-compose.prod.yml shadowing the
# COPY below — see the comment there for why.
#
# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_BASE_URL
ARG VITE_CRM_BASE_URL
ARG VITE_EMAIL_CONFIRMATION_PATH
ARG VITE_SENTRY_DSN

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --prefer-offline --no-audit --legacy-peer-deps

# Copy source
COPY . .

# If build-args were passed (CI/CD path), write them into .env.production so
# validate-env.mjs and Vite both pick them up; otherwise leave the file (from
# COPY . . above) untouched so a working frontend/.env.production committed
# on the host — the actual deploy path today — still works.
#
# This MUST be one RUN together with the build itself, and MUST end with
# `unset`. Docker re-injects every declared ARG as a real (env var) into the
# environment of *every* RUN in this stage, even when its value is an empty
# string (docker-compose's `args: {KEY: ${KEY:-}}` always sends an explicit
# --build-arg, never omits it). A bare env var, even empty, still shows up in
# `process.env`, and validate-env.mjs does `{...envFile, ...process.env}` —
# so an unset-but-declared ARG would silently beat a real .env.production
# value on every subsequent RUN, no matter what the previous RUN did. The
# only fix is unsetting it in the SAME shell invocation that then calls
# `npm run build`, right before it runs.
RUN if [ -n "$VITE_SUPABASE_URL" ]; then \
      { \
        echo "VITE_SUPABASE_URL=$VITE_SUPABASE_URL"; \
        echo "VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY"; \
        echo "VITE_API_BASE_URL=$VITE_API_BASE_URL"; \
        [ -n "$VITE_CRM_BASE_URL" ] && echo "VITE_CRM_BASE_URL=$VITE_CRM_BASE_URL"; \
        [ -n "$VITE_EMAIL_CONFIRMATION_PATH" ] && echo "VITE_EMAIL_CONFIRMATION_PATH=$VITE_EMAIL_CONFIRMATION_PATH"; \
        [ -n "$VITE_SENTRY_DSN" ] && echo "VITE_SENTRY_DSN=$VITE_SENTRY_DSN"; \
        true; \
      } > .env.production; \
    fi && \
    unset VITE_SUPABASE_URL VITE_SUPABASE_ANON_KEY VITE_API_BASE_URL \
          VITE_CRM_BASE_URL VITE_EMAIL_CONFIRMATION_PATH VITE_SENTRY_DSN && \
    NODE_OPTIONS='--max-old-space-size=2048' npm run build

# Stage 2: Runtime (nginx)
FROM nginx:alpine

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built dist from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=20s \
  CMD wget --quiet --tries=1 --spider http://localhost:80 || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
