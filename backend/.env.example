# Supabase
SUPABASE_URL=https://xxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...  # secret key (sb_secret_ format or legacy eyJ service_role)
# ES256 JWT (new Supabase projects): paste JWK JSON from Auth → JWKS endpoint, single line
SUPABASE_JWT_PUBLIC_KEY_JWK={"x":"...","y":"...","alg":"ES256","crv":"P-256","kty":"EC","use":"sig","kid":"..."}
# Legacy HS256 JWT (old Supabase projects): leave empty if using SUPABASE_JWT_PUBLIC_KEY_JWK
SUPABASE_JWT_SECRET=

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# App
APP_ENV=development  # development | production
ALLOWED_ORIGINS=http://localhost:5173,https://app.vitaloop.com
SECURITY_ENABLE_HEADERS=true
RATE_LIMIT_BACKEND=inmemory
RATE_LIMIT_TRUST_FORWARDED_FOR=false
RATE_LIMIT_FORWARDED_FOR_HEADER=x-forwarded-for
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_PREFIX=rl
AUTH_RATE_LIMIT_PER_MINUTE=60
ANALYZE_RATE_LIMIT_PER_MINUTE=30
PROTOCOL_RATE_LIMIT_PER_MINUTE=30
LAB_UPLOAD_RAW_RETENTION_DAYS=180
LAB_UPLOAD_RETENTION_BATCH_SIZE=500
RETENTION_ALERT_EMAIL=ops@vitaloop.today

# iHerb affiliate
IHERB_RCODE=VIT123
IHERB_BASE_URL=https://www.iherb.com/search

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...  # $49/month plan Price ID
STRIPE_SUCCESS_URL=http://localhost:5173/dashboard?sub=success
STRIPE_CANCEL_URL=http://localhost:5173/dashboard?sub=cancelled

# Email Service (choose one: Resend or SendGrid)
# Resend (preferred) - https://resend.com
RESEND_API_KEY=re_xxxxxxxx...
RESEND_FROM_EMAIL=onboarding@vitaloop.today

# SendGrid (alternative) - https://sendgrid.com
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=VITALOOP <noreply@vitaloop.today>

# Registration alerts
REGISTRATION_ALERT_EMAIL=info@vitaloop.today

# Frontend & CRM URLs
FRONTEND_BASE_URL=https://vitaloop.today
CRM_BASE_URL=https://crm.vitaloop.today
